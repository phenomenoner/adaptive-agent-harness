# Reserved example domains only. Replace every URL with the deployed production values.
AAR_PUBLIC_DATA_ROOT=/var/lib/aar
AAR_PUBLIC_ISSUER_URL=https://auth.example.com
AAR_PUBLIC_RESOURCE_URL=https://aar.example.com/mcp
AAR_PUBLIC_AUDIENCE=https://aar.example.com/mcp
AAR_PUBLIC_JWKS_URL=https://auth.example.com/.well-known/jwks.json
AAR_PUBLIC_DOCUMENTATION_URL=https://www.example.com/adaptive-agent-runtime
AAR_PUBLIC_REQUIRED_SCOPES=aar:rlm,aar:workspace
AAR_PUBLIC_BIND_HOST=0.0.0.0
AAR_PUBLIC_BIND_PORT=8000
AAR_PUBLIC_MAX_ACTIVE_TENANTS=128
AAR_PUBLIC_MAX_REQUEST_BODY_SIZE=1048576
AAR_PUBLIC_MAX_ARTIFACT_BYTES=1048576
AAR_PUBLIC_MAX_WORKSPACES_PER_TENANT=64
AAR_PUBLIC_MAX_KEYS_PER_WORKSPACE=256
AAR_PUBLIC_MAX_VALUE_BYTES=65536
AAR_PUBLIC_MAX_WORKSPACE_BYTES=262144
AAR_PUBLIC_MAX_RLM_JOBS_PER_TENANT=256
AAR_PUBLIC_MAX_RLM_QUERY_BYTES=16384
AAR_PUBLIC_MAX_RLM_MODEL_CALLS=8
AAR_PUBLIC_MAX_RLM_OUTPUT_TOKENS_PER_CALL=32768
AAR_PUBLIC_MAX_RLM_RESULT_BYTES_PER_CALL=262144
