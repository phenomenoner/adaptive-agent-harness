{
  "$defs": {
    "ArtifactBinding": {
      "additionalProperties": false,
      "properties": {
        "cell_execution_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "logical_name": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][-A-Za-z0-9._/]*$",
          "type": "string"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "operation": {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "operation",
              "type": "string"
            },
            "value": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        "role": {
          "enum": [
            "result",
            "evidence",
            "diagnostic",
            "intermediate"
          ],
          "type": "string"
        },
        "schema_version": {
          "const": "aar.artifact-binding.v1",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "type": "integer"
        },
        "workspace": {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "workspace",
              "type": "string"
            },
            "value": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$",
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        "workspace_generation": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "logical_name",
        "media_type",
        "digest",
        "size_bytes",
        "operation",
        "workspace",
        "workspace_generation",
        "cell_execution_id",
        "role"
      ],
      "type": "object"
    },
