        "pre_revision": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "type": "integer"
        },
        "result_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "schema_version": {
          "const": "aar.cell-commit-manifest.v1",
          "type": "string"
        },
        "source_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
