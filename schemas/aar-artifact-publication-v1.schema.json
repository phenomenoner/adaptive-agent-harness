        "attempt_id",
        "attempt_fence",
        "workspace",
        "workspace_generation",
        "pre_revision",
        "post_revision",
        "cell_execution_id",
        "source_digest",
        "result_digest",
        "checkpoint_digest",
        "artifact_stage_ids",
        "manifest_digest"
