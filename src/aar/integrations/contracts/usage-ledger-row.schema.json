{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/phenomenoner/adaptive-agent-harness/blob/v0.3.0a2/src/aar/integrations/contracts/usage-ledger-row.schema.json",
  "title": "One provider usage ledger row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "arm", "request_index", "purpose",
    "provider", "model", "reasoning_effort_requested",
    "reasoning_effort_effective", "input_tokens", "output_tokens",
    "total_tokens", "attempt", "used_in_final_artifact", "receipt_digest"
  ],
  "properties": {
    "schema_version": {"const": "aar-prime.usage-row.v1"},
    "run_id": {"type": "string"},
    "arm": {"enum": ["aar", "prime"]},
    "request_index": {"type": "integer", "minimum": 1},
    "purpose": {"enum": ["primary", "coordination", "verification", "retry", "recovery"]},
    "provider": {"const": "openai-codex"},
    "model": {"const": "gpt-5.6-luna"},
    "reasoning_effort_requested": {"const": "max"},
    "reasoning_effort_effective": {"const": "max"},
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "total_tokens": {"type": "integer", "minimum": 0},
    "reasoning_tokens": {"type": ["integer", "null"], "minimum": 0},
    "cache_read_tokens": {"type": ["integer", "null"], "minimum": 0},
    "cache_write_tokens": {"type": ["integer", "null"], "minimum": 0},
    "cost_usd": {"type": ["number", "null"], "minimum": 0},
    "attempt": {"type": "integer", "minimum": 1},
    "used_in_final_artifact": {"type": "boolean"},
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"},
    "receipt_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
